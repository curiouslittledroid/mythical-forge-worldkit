# The engine's schemas come from GitHub Packages (Phase 5 task B4), so installing them needs a token
# with `read:packages` on @curiouslittledroid. Never commit a token: this file hands npm the one in
# the environment, which is what a CI secret and a local shell both provide.
#
#   export NODE_AUTH_TOKEN=<a fine-grained PAT with read:packages>
#   npm install
#
# Without a token the install fails with a 401 from npm.pkg.github.com, and `tools/verify-world.sh`
# tells you what is missing rather than dying in the first tool that needs the schemas.

@curiouslittledroid:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
