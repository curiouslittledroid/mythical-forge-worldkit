---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import { sectionLabel, formatDate, formatT0, inline, tagHref, urlFor } from '../lib/site';

interface Props {
  entry: CollectionEntry<'pages'>;
  headings: { depth: number; slug: string; text: string }[];
  prev?: CollectionEntry<'pages'>;
  next?: CollectionEntry<'pages'>;
}

const { entry, headings, prev, next } = Astro.props;
const {
  title, section, summary, updated, era, t0, tags, kind, image, imageAlt, testimony,
  testimonySource,
} = entry.data;
// The transmission line is the Reader's own words — "told to me at the slips, in the BLAZE of
// CY 649" — so it is quoted where the account is, not over the pull-quote, where the site is
// speaking. Identify the account, then quote him.
const attribution = testimony
  ? [testimony.teller, testimony.transmission].filter(Boolean).join(', ')
  : '';
// Date first, then the person — the order he writes in, because the date is the entry's identity.
const byline = testimony
  ? [testimony.taken ? `${testimony.approx ? 'c. ' : ''}CY ${testimony.taken}` : '', testimony.teller]
      .filter(Boolean)
      .join(' · ')
  : '';
const toc = headings.filter((h) => h.depth === 2);
// "Year T0 − 22", calibrated to the Severing (T0), like the codex prose.
const year = formatT0(t0);
const description = summary
  ? summary.replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
  : `${title} — the Hollowfall codex.`;

const kindLabels: Record<string, string> = {
  HISTORY_EVENT: 'History',
  FIGURE: 'Figure',
  SETTLEMENT: 'Settlement',
  PLACE: 'Place',
  REGION: 'Region',
  FACTION: 'Power',
  GOD: 'God',
  RACE: 'People',
  ITEM: 'Relic',
  TOPIC: 'The world',
  NPC: 'Person',
  CREATURE: 'Creature',
};
---

<BaseLayout title={title} description={description} section={section}>
  <article class="mx-auto max-w-6xl px-5 pt-12 sm:px-8 sm:pt-16">
    <header class="max-w-3xl">
      <p class="eyebrow flex flex-wrap items-center gap-x-3">
        <a href={`/${section}/`} class="no-underline text-slate hover:text-ember"
          >{sectionLabel(section)}</a
        >
        {kindLabels[kind] !== sectionLabel(section) && (
          <>
            <span aria-hidden="true" class="text-dune">◆</span>
            <span>{kindLabels[kind] ?? kind}</span>
          </>
        )}
      </p>
      <h1 class="mt-3 text-[clamp(2.1rem,5vw,3.1rem)] tracking-tight">{title}</h1>
      {
        summary && (
          <p
            class="mt-4 text-[1.18rem] leading-relaxed text-ash"
            set:html={inline(summary)}
          />
        )
      }
      <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-1 text-[0.8rem] uppercase tracking-[0.12em] text-slate">
        {era && <span>{era.replace(/-/g, ' ')}</span>}
        {year && <span>Year {year}</span>}
        {
          tags.map((t) => (
            <a href={tagHref(t)} class="text-dune no-underline hover:text-ember">
              #{t}
            </a>
          ))
        }
        <span class="ml-auto normal-case tracking-normal text-dune">Updated {formatDate(updated)}</span>
      </div>
      <span class="rule-ember mt-6"></span>
    </header>

    {
      image && (
        <figure class="mt-10 max-w-[68ch]">
          <img
            src={`/img/${image}`}
            alt={imageAlt}
            width="2048"
            height="1152"
            loading="lazy"
            decoding="async"
            class="w-full border border-[var(--rule)]"
          />
        </figure>
      )
    }

    {
      testimony && testimony.quote && (
        <figure class="testimony-pull mt-10 max-w-[68ch]">
          <blockquote set:html={inline(testimony.quote)} />
          <figcaption>{byline}</figcaption>
        </figure>
      )
    }

    <div class="mt-10 grid gap-x-14 gap-y-12 md:grid-cols-[minmax(0,40rem)_13rem]">
      <div class="prose-hollow max-w-[68ch]">
        <slot />

        {
          testimony && testimony.paragraphs.length > 0 && (
            <section class="testimony">
              {
                testimonySource ? (
                  <a href={testimonySource} class="eyebrow no-underline hover:text-ember">
                    From the Reader's book →
                  </a>
                ) : (
                  <p class="eyebrow">From the Reader's book</p>
                )
              }
              <p class="testimony-heading" set:html={inline(testimony.heading || attribution)} />
              <div class="testimony-body">
                {testimony.paragraphs.map((para) => (
                  <p set:html={inline(para)} />
                ))}
              </div>
            </section>
          )
        }
      </div>

      <aside class="md:sticky md:top-8 md:self-start">
        {
          toc.length > 1 && (
            <nav class="marginalia" aria-label="On this page">
              <p class="eyebrow mb-2">On this page</p>
              <ul class="space-y-1.5 border-l border-[var(--rule)] pl-3">
                {toc.map((h) => (
                  <li>
                    <a href={`#${h.slug}`} class="no-underline hover:text-ember">
                      {h.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }
        <nav class="marginalia mt-8 border-t border-[var(--rule)] pt-4" aria-label="Nearby">
          <p class="eyebrow mb-2">Nearby</p>
          <ul class="space-y-2">
            {
              prev && (
                <li>
                  <a href={urlFor(prev.data.section, prev.data.slug)} class="no-underline">
                    ← {prev.data.title}
                  </a>
                </li>
              )
            }
            {
              next && (
                <li>
                  <a href={urlFor(next.data.section, next.data.slug)} class="no-underline">
                    {next.data.title} →
                  </a>
                </li>
              )
            }
          </ul>
        </nav>
        <p class="marginalia mt-8 border-t border-[var(--rule)] pt-4 opacity-80">
          Only what a resident of Hollowfall would know.
        </p>
      </aside>
    </div>
  </article>
</BaseLayout>
