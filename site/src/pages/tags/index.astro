---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { tagHref, tagLabel } from '../../lib/site';

// Every tag the exporter published, with its count. The vocabulary is curated in
// tools/site_export.py (PUBLISHED_TAGS), so this list is short and stable on purpose.
const pages = await getCollection('pages');
const counts = new Map<string, number>();
for (const page of pages) {
  for (const tag of page.data.tags) counts.set(tag, (counts.get(tag) ?? 0) + 1);
}
const tags = [...counts.keys()].sort((a, b) => tagLabel(a).localeCompare(tagLabel(b), 'en'));
const blurb =
  'The threads that run through the codex: the peoples, the powers, and the broken machinery of the world.';
---

<BaseLayout title="Themes" description={blurb} section="codex">
  <div class="mx-auto max-w-6xl px-5 pt-12 sm:px-8 sm:pt-16">
    <header class="max-w-2xl">
      <p class="eyebrow">
        <a href="/codex/" class="no-underline text-slate hover:text-ember">The Codex</a>
        <span aria-hidden="true" class="mx-2 text-dune">◆</span> Themes
      </p>
      <h1 class="mt-3 text-[clamp(2.2rem,5vw,3.2rem)]">Themes</h1>
      <p class="mt-4 text-[1.18rem] text-ash">{blurb}</p>
      <span class="rule-ember mt-6"></span>
      <p class="marginalia mt-4">
        {tags.length} themes across every section. Cross-cutting, so a theme page can hold a people, a
        ruin and a war together.
      </p>
    </header>

    <ul class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        tags.map((tag) => (
          <li>
            <a
              href={tagHref(tag)}
              class="flex items-baseline justify-between gap-4 border border-[var(--rule)] bg-parchment/40 px-4 py-3 no-underline transition-colors hover:border-ember hover:bg-parchment/85"
            >
              <span class="text-[1.02rem] text-ash">{tagLabel(tag)}</span>
              <span class="marginalia">{counts.get(tag)}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
