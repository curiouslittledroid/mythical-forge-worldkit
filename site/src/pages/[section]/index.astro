---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntryCard from '../../components/EntryCard.astro';
import { byTimeThenTitle, sectionLabel, sections } from '../../lib/site';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  const present = [...new Set(pages.map((p) => p.data.section))];
  return present.map((section) => ({
    params: { section },
    props: {
      section,
      entries: pages.filter((p) => p.data.section === section).sort(byTimeThenTitle),
    },
  }));
}

interface Props {
  section: string;
  entries: CollectionEntry<'pages'>[];
}

const { section, entries } = Astro.props;

const blurbs: Record<string, string> = {
  world: 'The planet, the leylines, and the five debts that magic takes its price from.',
  history: 'From the revolt against the Choir to the Uncovering: nine hundred years of aftermath.',
  peoples: 'Who lives here, what it cost them, and what they will not say about it.',
  gods: 'Thirteen gods. Three dead, five silent, five changed and hungry.',
  places: 'Regions, towns, ruins and wards — including the Dust Road, where the campaigns begin.',
  powers: 'The churches, guilds, holds and leagues that survived the fall, and what they owe each other.',
  relics: 'What the golden age left behind, and what it costs to keep it.',
  creatures: 'The bestiary, still being written.',
  people: 'Named people of the Dust Road.',
};

const label = sectionLabel(section);
const blurb = blurbs[section] ?? '';
// Dated sections (History) run oldest first; the count line says so rather than surprising readers.
const chronological = entries.some((e) => e.data.t0);
const order = sections.findIndex((s) => s.slug === section);
const nextSection = sections[order + 1];
---

<BaseLayout title={label} description={blurb} section={section}>
  <div class="mx-auto max-w-6xl px-5 pt-12 sm:px-8 sm:pt-16">
    <header class="max-w-2xl">
      <p class="eyebrow">The Codex</p>
      <h1 class="mt-3 text-[clamp(2.2rem,5vw,3.2rem)]">{label}</h1>
      <p class="mt-4 text-[1.18rem] text-ash">{blurb}</p>
      <span class="rule-ember mt-6"></span>
      <p class="marginalia mt-4">
        {entries.length} entries{chronological && ', oldest first'}
      </p>
    </header>

    <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        entries.map((entry) => (
          <li>
            <EntryCard entry={entry} />
          </li>
        ))
      }
    </ul>

    {
      nextSection && (
        <p class="marginalia mt-16 border-t border-[var(--rule)] pt-6">
          Next in the codex:{' '}
          <a href={`/${nextSection.slug}/`} class="no-underline">
            {nextSection.label} →
          </a>
        </p>
      )
    }
  </div>
</BaseLayout>
