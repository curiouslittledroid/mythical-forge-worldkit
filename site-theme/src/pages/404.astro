---
import { SITE } from '../lib/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not in the codex" description="That page is not in the codex.">
  <div class="mx-auto max-w-2xl px-5 py-28 text-center sm:px-8">
    <p class="eyebrow">404</p>
    <h1 class="mt-3 text-[clamp(2rem,5vw,3rem)]">Not in the codex</h1>
    <p class="mt-5 text-[1.08rem] text-ash">
      The page you asked for is not one of ours. It may have been renamed — the codex is a living
      draft — or it may be one of the things the residents of {SITE.name} do not know.
    </p>
    <p class="mt-8">
      <a href="/codex/" class="no-underline">Try the Codex</a>
    </p>
  </div>
</BaseLayout>
